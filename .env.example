# ==== MongoDB (local Compass) ====
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=call_analytics

# ==== Groq API (free key from https://console.groq.com/keys) ====
GROQ_API_KEY=your_groq_api_key_here

# ==== Flask ====
SECRET_KEY=change-this-to-any-random-secret-string
FLASK_DEBUG=True

# ==== Admin access ====
# Comma-separated emails that get admin access automatically at signup.
# e.g. ADMIN_EMAILS=you@example.com,ops@example.com
# To promote an EXISTING user instead, run: flask --app app.py make-admin
ADMIN_EMAILS=

# ==== Application Base URL ====
APP_BASE_URL=http://127.0.0.1:5000

# ==== Gmail SMTP Configuration ====
# Note: For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=foramsoni2004@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_DEFAULT_SENDER=foramsoni2004@gmail.com

# ==== Google OAuth 2.0 Credentials ====
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
